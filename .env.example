TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
CHECK_INTERVAL_MIN=60
# Segundos entre um produto e outro postado no grupo
POST_INTERVAL_SEC=60
# IDs de usuário do Telegram (separados por vírgula) que podem dar comandos.
# Vazio = qualquer pessoa do chat configurado.
ADMIN_IDS=
# Código de afiliado da Amazon (ex.: seunome-20). Vazio = links sem afiliado.
AMAZON_TAG=
# Opcional: um ID de rastreamento por canal para ver no relatório de onde vêm as vendas
AMAZON_TAG_TELEGRAM=
AMAZON_TAG_WHATSAPP=

# WhatsApp (ponte Baileys em whatsapp/, rode: cd whatsapp && npm install && npm start)
WHATSAPP_BRIDGE_PORT=3001
# JID do grupo (ex.: 1203630...@g.us). Veja em http://127.0.0.1:3001/groups. Vazio = WhatsApp desligado.
WHATSAPP_GROUP_ID=
# 1 = liga a ponte mesmo sem grupo geral (para usar só grupos de tema)
WHATSAPP_ENABLED=
# Números que podem dar comandos no grupo (com DDI, separados por vírgula), ex.: 5511999999999
WHATSAPP_ADMINS=

# Temas: cada termo é buscado no máximo a cada N minutos, com pausa entre buscas
TERM_CHECK_MIN=120
TERM_GAP_SEC=90
